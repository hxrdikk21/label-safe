# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# --- docker compose ---
POSTGRES_USER=rxguard_user
POSTGRES_PASSWORD=
POSTGRES_DB=rxguard_db

# --- application (src/rxguard/core/config.py) ---
DATABASE_URL=postgresql+asyncpg://rxguard_user:<password>@localhost:5432/rxguard_db
# Required: at least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=

# --- models ---
# real: sentence-transformers embeddings + cross-encoder (pip install -e ".[ml]") | fake: offline test doubles
MODEL_MODE=real
# template | gemini (all LLM work uses Gemini; key from https://aistudio.google.com/apikey)
LLM_BACKEND=template
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- production (deployment/docker-compose.prod.yml; see docs/PRODUCTION.md) ---
# development | production. Production hides /docs and refuses CORS_ORIGINS=["*"].
APP_ENV=development
# Public hostname; Caddy gets a Let's Encrypt certificate for it. localhost = local test CA.
DOMAIN=localhost
# Other browser origins allowed to call the API, as JSON. [] = same origin only (recommended).
CORS_ORIGINS=[]
# DDInter rules are CC BY-NC-SA 4.0 (non-commercial). Set false for a commercial deployment.
INCLUDE_DDINTER=true
# Gemini calls per day; past it, answers quote the labels instead.
GEMINI_DAILY_BUDGET=500
# Requests per client IP (per minute; registrations per hour).
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_EXPLAIN_PER_MINUTE=10
RATE_LIMIT_ANALYZE_PER_MINUTE=30
RATE_LIMIT_SEARCH_PER_MINUTE=120
RATE_LIMIT_REGISTER_PER_HOUR=5
# API worker processes (each loads the models, ~1 GB RAM).
WEB_CONCURRENCY=1
# Labels fetched by the first bootstrap (500 = the whole catalogue, ~20 min).
LIMIT=500
LOG_LEVEL=INFO
# Nightly database dumps kept by the backup service.
BACKUP_KEEP=7
